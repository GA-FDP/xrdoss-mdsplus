#!/bin/sh
# The mdsip listener: one process per accepted connection.
#
#   fork    a new process per connection -- the whole point. Without it, one
#           mdsip serves every client and they share tree state.
#   nofork  do NOT interpose a socketpair; exec the child directly on the
#           accepted socket so it lands on fd 0/1/2 exactly as inetd would.
#           Without this, socat relays through a pipe and mdsip's getpeername
#           sees a socketpair instead of the client.
#
# Losing either flag serves shared tree state again -- silently, and only under
# concurrency. Containerfile.mdsip greps this file for both.
# FDP_MDSIP_SOCKET set: listen on that Unix socket instead of TCP. Production
# uses this because the sandbox is rootless and a TCP hop into it crosses
# pasta, which stalls every reply above ~4 MB for a retransmission timeout.
#   unlink-early  remove a stale socket file from a previous run before bind
#   mode=666      any local process may connect -- the same reachability as the
#                 bridge-address TCP port had; the directory's 0711 keeps it
#                 unlistable (d3d-origin-admin docs/specs/2026-10-13-mdsip-unix-socket-design.md)
if [ -n "${FDP_MDSIP_SOCKET:-}" ]; then
  exec /usr/bin/socat "UNIX-LISTEN:$FDP_MDSIP_SOCKET,fork,unlink-early,mode=666" \
       EXEC:/usr/local/bin/fdp-mdsip-connection,nofork
fi
exec /usr/bin/socat TCP-LISTEN:8000,fork,reuseaddr \
     EXEC:/usr/local/bin/fdp-mdsip-connection,nofork
